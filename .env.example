# ---------------------------------------------------------------------------
# Hugging Face access token - https://huggingface.co/settings/tokens
# ---------------------------------------------------------------------------
# Strongly recommended. The primary Space (hysts/Shap-E) runs on ZeroGPU, whose
# quota for anonymous callers is shared per IP and is exhausted after a handful
# of generations - the app then returns "has exhausted its GPU quota" until it
# resets. A token gives you your own quota. A "Read" token is enough; it is
# only ever used server-side and is never sent to the browser.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Meshy AI API key - https://www.meshy.ai
# ---------------------------------------------------------------------------
# Optional paid fallback, used only when the Hugging Face Space fails. Leave
# empty to disable Meshy entirely.
MESHY_API_KEY=
